# Nusxa oling: cp .env.example .env  — va qiymatlarni o'zgartiring. .env git ga qo'shilmaydi.

# --- Profillar ---
# Ollama ni Docker ichida (GPU bilan) ishga tushirish uchun: COMPOSE_PROFILES=ollama
# Ollama hostda ishlasa bo'sh qoldiring va EMBEDDING_BASE_URL=http://host.docker.internal:11434 qiling.
COMPOSE_PROFILES=ollama

# --- API ---
API_IMAGE=rag-api:latest
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
DB_MIGRATE_ON_STARTUP=true
# Swagger UI: http://localhost:8080/swagger
SWAGGER_ENABLED=true
# Hybrid qidiruv (vector + kalit so'z)
RAG_HYBRID_SEARCH=false
# Hujjat boshqaruvi (yuklash/o'chirish/reindex) uchun X-Api-Key. Bo'sh bo'lsa tekshirilmaydi.
ADMIN_API_KEY=change-me-admin-key
CHAT_REQUESTS_PER_MINUTE=20

# --- PostgreSQL + pgvector ---
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# --- MinIO ---
MINIO_ROOT_USER=rag-minio
MINIO_ROOT_PASSWORD=change-me-min-8-chars
MINIO_BUCKET=documents
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Ollama (embedding) ---
OLLAMA_PORT=11434
# Modellar saqlanadigan joy: nomli volume (ollama) yoki hostdagi papka, masalan /data/ollama
OLLAMA_MODELS_DIR=ollama
# Ollama shu compose da (profil ollama): http://ollama:11434
# Ollama alohida konteyner/hostda (port 11434 hostga ochiq): http://host.docker.internal:11434, COMPOSE_PROFILES= bo'sh
# API ni dotnet run bilan ishga tushirsangiz: appsettings.json dagi http://localhost:11434 ishlatiladi
EMBEDDING_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024

# --- LLM (OpenAI-compatible) ---
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
# Lokal Qwen (shu Ollama orqali): LLM_BASE_URL=http://ollama:11434/v1, LLM_MODEL=qwen2.5:7b, LLM_API_KEY=ollama
# LLM_MODEL — https://openrouter.ai/models dagi to'liq id (":free" bilan tugaydigan bepul modellar) yoki openrouter/free (bepul modellar orasidan avtomatik tanlaydi). Kalit: https://openrouter.ai/keys
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/free
LLM_TEMPERATURE=0.2
