{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*",
  "Rag": {
    "Chunking": { "TextSize": 1000, "Overlap": 150, "MinLength": 50, "JsonMaxSize": 3000 },
    "Retrieval": { "TopK": 8, "MinScore": 0.35, "HistoryMessages": 6, "Hybrid": false },
    "Ingestion": { "EmbeddingBatchSize": 16, "MaxRetries": 3, "MaxFileSizeMb": 50 }
  },
  "Database": { "MigrateOnStartup": true },
  "Swagger": { "Enabled": true },
  "Security": { "AdminApiKey": "", "ChatRequestsPerMinute": 20 },
  "ConnectionStrings": {
    "Db": "Host=localhost;Port=5433;Database=rag;Username=rag;Password=change-me"
  },
  "Embedding": { "BaseUrl": "http://localhost:11434", "Model": "bge-m3", "Dimensions": 1024 },
  "Llm": { "BaseUrl": "https://openrouter.ai/api/v1", "ApiKey": "", "Model": "openrouter/free", "Temperature": 0.2 },
  "Minio": { "Endpoint": "localhost:9000", "AccessKey": "rag-minio", "SecretKey": "change-me-min-8-chars", "Bucket": "documents", "UseSsl": false }
}
